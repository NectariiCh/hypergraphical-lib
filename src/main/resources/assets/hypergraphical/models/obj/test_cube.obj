# Hypergraphical test asset: 1x1x1 cube centred on the model origin, split into two
# usemtl groups so multi-material sub-mesh routing can be tested. UVs run 0..1 per face,
# which makes a material's tiling and offset values obvious at a glance.
mtllib test_cube.mtl
o test_cube

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# Four vertical faces carry the body material.
usemtl body
f 2/1/1 1/2/1 4/3/1
f 2/1/1 4/3/1 3/4/1
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
f 1/1/3 5/2/3 8/3/3
f 1/1/3 8/3/3 4/4/3
f 6/1/4 2/2/4 3/3/4
f 6/1/4 3/3/4 7/4/4

# Top and bottom carry the trim material.
usemtl trim
f 1/1/5 2/2/5 6/3/5
f 1/1/5 6/3/5 5/4/5
f 4/1/6 8/2/6 7/3/6
f 4/1/6 7/3/6 3/4/6
